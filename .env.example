# Codex OAuth is handled via `hermes model` on first run — no API key needed.
# Uncomment if switching to a direct API key provider.
# OPENAI_API_KEY=

# Data & Docker
# Host path mounted as Hermes home (/opt/data in the container).
HERMES_DATA_DIR=./data/hermes
# Match host user so files in data/hermes stay owned by you.
HERMES_UID=
HERMES_GID=

# Messaging gateway (optional; profile `gateway`)
# Bot token from @BotFather — enables Telegram when set.
# TELEGRAM_BOT_TOKEN=
#
# Comma-separated Telegram user IDs allowed to DM the bot.
# Get yours: message @userinfobot. Leave empty to allow anyone.
# TELEGRAM_ALLOWED_USERS=
#
# Comma-separated group chat IDs the bot will respond in (leave empty = allow all groups).
# TELEGRAM_ALLOWED_CHATS=
#
# Home channel for cron jobs and proactive messages.
# TELEGRAM_HOME_CHANNEL=          # chat_id (negative for groups)
# TELEGRAM_HOME_CHANNEL_NAME=Home
# TELEGRAM_HOME_CHANNEL_THREAD_ID=  # forum topic ID, if applicable

# Growatt Bridge (optional; add `growatt` to COMPOSE_PROFILES, copy .env.growatt.example → .env.growatt)
# COMPOSE_PROFILES=growatt
# GROWATT_BRIDGE_IMAGE=ghcr.io/qbamca/growatt-bridge:latest
# GROWATT_BRIDGE_BUILD_CONTEXT=../growatt-bridge  # local dev: build from source instead
# GROWATT_BRIDGE_PORT=8081
# GROWATT_AUDIT_DIR=./data/growatt-bridge
