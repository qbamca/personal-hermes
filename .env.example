# Docker / infra vars — copy to .env and fill in.
# Per-profile credentials (Telegram tokens, etc.) go in profiles/<name>/.env.example.

# Host path mounted as Hermes home (/opt/data in the container).
HERMES_DATA_DIR=./data/hermes
# Match host user so files in data/hermes stay owned by you.
HERMES_UID=
HERMES_GID=

# Growatt Bridge (optional; add `growatt` to COMPOSE_PROFILES, copy .env.growatt.example → .env.growatt)
# COMPOSE_PROFILES=growatt
# GROWATT_BRIDGE_IMAGE=ghcr.io/qbamca/growatt-bridge:latest
# GROWATT_BRIDGE_PORT=8081
# GROWATT_AUDIT_DIR=./data/growatt-bridge
