# Solar profile credentials — copy to data/hermes/profiles/solar/.env and fill in.

# Bot token from @BotFather (separate bot from the default gateway).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to DM the solar bot.
TELEGRAM_ALLOWED_USERS=

# Home channel for cron/proactive solar delivery.
# TELEGRAM_HOME_CHANNEL=          # chat_id (negative for groups)
# TELEGRAM_HOME_CHANNEL_NAME=Solar
# TELEGRAM_HOME_CHANNEL_THREAD_ID=
