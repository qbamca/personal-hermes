# Default profile credentials — values live in data/hermes/.env (gitignored).

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to DM the bot.
TELEGRAM_ALLOWED_USERS=

# Home channel for cron/proactive delivery.
# TELEGRAM_HOME_CHANNEL=          # chat_id (negative for groups)
# TELEGRAM_HOME_CHANNEL_NAME=Home
# TELEGRAM_HOME_CHANNEL_THREAD_ID=
